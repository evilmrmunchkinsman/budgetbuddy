# Copy to .env and edit. NEVER commit .env.

# --- Group 3 (Backend API) ---
PORT=3000
NODE_ENV=development
# Set to true to use the temporary mocks instead of Group 1/2 modules (not allowed in production)
USE_MOCKS=false
# Max characters accepted in an alert message
MAX_ALERT_LENGTH=1000
# Spends at or above this amount are flagged as "large"
LARGE_SPEND_THRESHOLD=10000
# Same merchant + same amount within this many minutes is flagged as a duplicate
DUPLICATE_WINDOW_MINUTES=10
CURRENCY=INR

# --- Group 1 (agent.js / Claude tool-use loop) - read by Group 1, not by Group 3 ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Group 2 (db.js / SQLite) - placeholder, Group 2 decides the real variable names ---
# DB_PATH=./budgetbuddy.db
