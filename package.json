{
  "name": "budgetbuddy",
  "version": "0.1.0",
  "private": true,
  "description": "BudgetBuddy backend API, database, tools and reporting",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.11"
  },
  "scripts": {
    "init-db": "node -e \"require('./db').initDatabase(); console.log('BudgetBuddy database initialized.')\"",
    "start": "node server.js",
    "start:mock": "node server.js --mock",
    "dev": "node --watch server.js --mock",
    "replay": "node scripts/replay-alerts.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
